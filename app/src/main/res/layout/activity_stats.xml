<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/AeroHockey.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/stats_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStats"
        style="@style/AeroHockey.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTotalGames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_total_games"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:paddingVertical="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/text_secondary" />

            <TextView
                android:id="@+id/tvPlayer1Wins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_player1_wins"
                android:textColor="@color/player1_color"
                android:textSize="18sp"
                android:paddingVertical="8dp" />

            <ProgressBar
                android:id="@+id/progressPlayer1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progressTint="@color/player1_color"
                android:max="100" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/text_secondary" />

            <TextView
                android:id="@+id/tvPlayer2Wins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_player2_wins"
                android:textColor="@color/player2_color"
                android:textSize="18sp"
                android:paddingVertical="8dp" />

            <ProgressBar
                android:id="@+id/progressPlayer2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:progressTint="@color/player2_color"
                android:max="100" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
