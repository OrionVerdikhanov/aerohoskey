    <!-- О приложении -->
    <string name="about_title">О игре</string>
    <string name="about_description">Классическая игра Аэрохоккей для двух игроков на одном устройстве. Погрузитесь в атмосферу настоящего хоккея с реалистичной физикой, красочными эффектами и захватывающим геймплеем!</string>
    <string name="about_features">• Режим для двух игроков\n• AI-противник с 4 уровнями сложности\n• Система бонусов и power-ups\n• Достижения и статистика\n• Реалистичная физика\n• Красочные визуальные эффекты\n• Поддержка звука и вибрации</string>
    <string name="about_version">Версия: %1$s</string>
    <string name="about_developer">AeroHockey Team</string>
    <string name="about_year">© 2024</string>
    <string name="about_privacy">Политика конфиденциальности</string>

