<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Стили для компонентов -->

    <!-- Card Styles -->
    <style name="Widget.AeroHockey.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="cardBackgroundColor">@color/md_theme_surfaceContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.AeroHockey.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/md_theme_outline</item>
        <item name="cardBackgroundColor">@color/md_theme_surface</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.AeroHockey.Button" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">6dp</item>
        <item name="backgroundTint">@color/md_theme_primary</item>
    </style>

    <style name="Widget.AeroHockey.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/md_theme_outline</item>
    </style>

    <style name="Widget.AeroHockey.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Text Styles -->
    <style name="TextAppearance.AeroHockey.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/md_theme_onBackground</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AeroHockey.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/md_theme_onBackground</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AeroHockey.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.AeroHockey.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Switch Style -->
    <style name="Widget.AeroHockey.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="thumbTint">@color/md_theme_primary</item>
        <item name="trackTint">@color/md_theme_surfaceVariant</item>
    </style>

    <!-- ProgressBar Style -->
    <style name="Widget.AeroHockey.ProgressBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/md_theme_tertiary</item>
        <item name="trackColor">@color/md_theme_surfaceVariant</item>
        <item name="trackCornerRadius">8dp</item>
        <item name="trackThickness">8dp</item>
    </style>

    <!-- Divider Style -->
    <style name="Widget.AeroHockey.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/md_theme_outlineVariant</item>
        <item name="android:alpha">0.3</item>
    </style>
</resources>
