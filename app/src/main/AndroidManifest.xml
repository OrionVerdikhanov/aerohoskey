<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Разрешения для рекламы -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Удаление разрешения AD_ID, если не требуется (для детских приложений) -->
    <!-- Раскомментируйте, если нужно убрать трекинг рекламного ID -->
    <!--
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    -->

    <application
        android:name=".AeroHockeyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AeroHockey"
        tools:targetApi="31">

        <!-- Meta-data для Yandex Mobile Ads SDK -->
        <!-- Укажите false, если приложение НЕ для детей младше 13 лет -->
        <meta-data
            android:name="@string/yandex_mobileads_age_restricted_user"
            android:value="false" />

        <!-- Отключение автоматической инициализации SDK (инициализируем вручную) -->
        <meta-data
            android:name="com.yandex.mobile.ads.AUTOMATIC_SDK_INITIALIZATION"
            android:value="false" />

        <!-- SplashActivity - стартовый экран -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AeroHockey.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity - главное меню -->
        <activity
            android:name=".ui.menu.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ModeSelectionActivity - выбор режима игры -->
        <activity
            android:name=".ui.mode.ModeSelectionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- GameActivity - игровой экран -->
        <activity
            android:name=".ui.game.GameActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- ResultActivity - экран результатов -->
        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- SettingsActivity - настройки -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- StatsActivity - статистика -->
        <activity
            android:name=".ui.stats.StatsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- AboutActivity - о приложении -->
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- AchievementsActivity - достижения -->
        <activity
            android:name=".ui.achievements.AchievementsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- TutorialActivity - обучение -->
        <activity
            android:name=".ui.tutorial.TutorialActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ShopActivity - магазин скинов -->
        <activity
            android:name=".ui.shop.ShopActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/shop_title" />

        <!-- QuestsActivity - ежедневные задания -->
        <activity
            android:name=".ui.quests.QuestsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/quests_title" />

        <!-- LeaderboardActivity - таблица рекордов -->
        <activity
            android:name=".ui.leaderboard.LeaderboardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:label="@string/leaderboard_title" />

    </application>

</manifest>
